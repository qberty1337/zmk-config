# USB dongle: split central for the two corne halves (built as peripherals, see build.yaml).
if SHIELD_CORNE_DONGLE

config ZMK_KEYBOARD_NAME
    default "CorneDongle"

config ZMK_SPLIT
    default y

config ZMK_SPLIT_ROLE_CENTRAL
    default y

config ZMK_SPLIT_BLE_CENTRAL_PERIPHERALS
    default 2

# 2 halves + 3 BT profiles (keymap uses BT_SEL 0-2)
config BT_MAX_CONN
    default 5

config BT_MAX_PAIRED
    default 5

endif
